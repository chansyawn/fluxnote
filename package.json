    "@lexical/code-core": "^0.44.0",
    "@lexical/code-shiki": "^0.44.0",
    "@lexical/extension": "^0.44.0",
    "@lexical/headless": "^0.44.0",
    "@lexical/history": "^0.44.0",
    "@lexical/link": "^0.44.0",
    "@lexical/list": "^0.44.0",

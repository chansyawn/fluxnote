{
  "name": "fluxnotes",
  "version": "0.0.30",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "vp config",
    "dev": "vp exec --filter @fluxnotes/desktop -- electron-forge start",
    "test": "vp run -r test",
    "package": "vp run @fluxnotes/desktop#package",
    "make": "vp run @fluxnotes/desktop#make",
    "flux": "vp run @fluxnotes/desktop#flux",
    "release:macos": "vp run @fluxnotes/desktop#release:macos",
    "db:generate": "vp run @fluxnotes/desktop#db:generate",
    "i18n:extract": "node scripts/i18n/extract.mjs",
    "i18n:check": "node scripts/i18n/check-i18n.mjs"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.1",
    "@commitlint/config-conventional": "^21.0.1",
    "@lingui/cli": "6.0.1",
    "@lingui/format-po": "6.0.1",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": "24.15.0"
  },
  "packageManager": "pnpm@11.5.1"
}

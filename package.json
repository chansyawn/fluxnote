    "@types/node": "^25.5.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.5",
    "drizzle-kit": "^0.31.10",
    "electron": "41.3.0",
    "typescript": "~5.9.3",
    "vite": "catalog:",
    "vite-plus": "catalog:"

{
  "name": "fluxnotes",
  "version": "0.0.13",
  "private": true,
  "description": "A lightweight, always-on-top editor for AI-first workflows.",
  "license": "MIT",
  "author": "Fluxnotes",
  "bin": {
    "flux": ".vite/cli/flux-cli.mjs"
  },
  "type": "module",
  "main": ".vite/build/main.cjs",
  "imports": {
    "#global.css": "./src/renderer/global.css"
  },
  "scripts": {
